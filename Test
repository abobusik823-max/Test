--==================================================
-- BUTTON CREATOR
--==================================================

local function createButton(text, y)
    local button = Instance.new("TextButton")

    button.Size = UDim2.new(1, -30, 0, 52)
    button.Position = UDim2.fromOffset(15, y)

    button.BackgroundColor3 = Color3.fromRGB(28, 29, 40)
    button.Text = ""
    button.AutoButtonColor = false

    button.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = button

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -80, 1, 0)
    label.Position = UDim2.fromOffset(15, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(230, 230, 240)
    label.TextSize = 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    local state = Instance.new("TextLabel")
    state.Size = UDim2.fromOffset(48, 27)
    state.Position = UDim2.new(1, -62, 0.5, -13)

    state.BackgroundColor3 = Color3.fromRGB(55, 56, 70)
    state.Text = "OFF"
    state.TextColor3 = Color3.fromRGB(175, 175, 190)
    state.TextSize = 10
    state.Font = Enum.Font.GothamBold

    state.Parent = button

    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 8)
    sc.Parent = state

    local enabled = false

    button.Activated:Connect(function()
        enabled = not enabled

        state.Text = enabled and "ON" or "OFF"

        state.BackgroundColor3 =
            enabled
            and Color3.fromRGB(75, 125, 255)
            or Color3.fromRGB(55, 56, 70)

        if text == "Aim Assist" then
            Config.AimAssist = enabled

        elseif text == "Target ESP" then
            Config.ESP = enabled

        elseif text == "FOV Circle" then
            fovCircle.Visible = enabled
        end
    end)

    return button
end

createButton("Aim Assist", 82)
createButton("Target ESP", 142)
createButton("FOV Circle", 202)

